# Plaid credentials (from dashboard.plaid.com)
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
# sandbox | development | production
PLAID_ENV=development

# Local dev only
PORT=3001

# Vercel KV — auto-populated when you link a KV database in the Vercel dashboard.
# You do NOT need to set these manually; Vercel injects them automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
