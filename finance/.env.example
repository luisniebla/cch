# Plaid credentials (from dashboard.plaid.com)
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
# sandbox | development | production
PLAID_ENV=development

# Local dev only
PORT=3001

# Upstash Redis — auto-populated when you add the Upstash Redis integration
# in your Vercel project dashboard under Storage > Browse Marketplace.
# You do NOT need to set these manually.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
